# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Comma-separated Telegram user IDs. Empty = anyone can use the bot.
ALLOWED_USER_IDS=

# Upload destination
# Optional. Uses your Gofile account for uploads and share-link downloads.
# Without it Gofile uses guest uploads (public folder per upload) and guest tokens.
GOFILE_TOKEN=
# Optional. Enables /px uploads to Pixeldrain and authenticates Pixeldrain
# downloads. Create an account, verify your email, then make an API key at
# https://pixeldrain.com/user/api_keys.
# A free key does not raise Pixeldrain's free per-IP download limit. A Pro or
# Prepaid account uses its own transfer quota and allows direct downloads.
PIXELDRAIN_API_KEY=
# Gofile share links are read with a temporary guest token. Only change this if
# Gofile rotates the website-token salt in https://gofile.io/js/wt.obf.js.
# GOFILE_WT_SALT=12af056dacea0b

# Limits
# 0 = no bot-side size limit. Gofile's plan limits and the disk still apply.
MAX_FILE_SIZE=0
# Used by a local worker/fallback poller. Remote jobs each get their own
# GitHub Actions runner, so this does not limit the number of dispatched jobs.
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT=7200
# 0 = run forever (local). GitHub Actions sets ~4h45m per run.
BOT_RUN_SECONDS=0
MULTI_FILE_MODE=largest

# Local PC runner
# 1 = this installation is the primary Telegram poller. On startup it cancels
# any active GitHub Actions run, then starts one on-demand Actions run when the
# bot exits (unless AUTO_HANDOFF=0). Requires the `gh` CLI and `gh auth login`.
LOCAL_MODE=0
# Leave empty to default to LOCAL_MODE. Set 0 to stop without handing over.
AUTO_HANDOFF=
# Optional; normally detected from the current gh login and git branch.
ACTIONS_REPO=
ACTIONS_REF=
# 1 = the PC only polls Telegram; every mirror job runs in a one-shot GitHub
# Actions worker (.github/workflows/job.yml). Requires REMOTE_JOB_KEY and gh.
REMOTE_JOBS=0
# Fernet key shared by the PC and the REMOTE_JOB_KEY repository secret.
# Generate it, write it here, and upload the secret with:
#   powershell -ExecutionPolicy Bypass -File scripts\configure-remote.ps1
# Keep it out of git and out of chat.
REMOTE_JOB_KEY=
# Optional name of the worker workflow.
REMOTE_WORKFLOW=job.yml
# Optional tracking file for remote job ids.
REMOTE_STATE_FILE=.state/remote-jobs.json

# Cloudflare Worker controller (optional)
# The Worker replaces the PC poller: Telegram calls its webhook, and it
# dispatches the same one-shot GitHub Actions jobs. Deploy it with
#   powershell -ExecutionPolicy Bypass -File scripts\configure-cloudflare.ps1
# The script fills in the URL and webhook secret below.
CLOUDFLARE_WORKER_URL=
TELEGRAM_WEBHOOK_SECRET=
# GitHub token used by the Worker to dispatch and cancel workflow runs.
# Leave empty to use the current `gh auth token`. A fine-grained token needs
# Actions: read and write on the mirror-bot repository.
# GITHUB_TOKEN=

# Video downloads
YTDLP_FORMAT=bv*+ba/b
# Optional Netscape-format cookies file for age/region locked sites.
COOKIES_FILE=

# Paths
DOWNLOAD_DIR=downloads
# The PC runner overrides this with .state/local-telegram.json so the tracked
# Actions state file stays clean.
STATE_FILE=.state/telegram.json
ARIA2C_PATH=aria2c
# payload-dumper-go is used by `/gf <link> -dump boot,vendor` to extract
# partitions from Android OTA payload.bin files. The Actions workflow and
# Docker image install it automatically.
PAYLOAD_DUMPER_PATH=payload-dumper-go

# Debug
LOG_LEVEL=INFO
# Only enable for local testing. Never expose this bot publicly with private URLs allowed.
ALLOW_PRIVATE_URLS=0
